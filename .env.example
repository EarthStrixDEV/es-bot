# Gateway (server/). Anything left unset falls back to a mock, so the app runs with no keys.
PORT=8787
DATA_PATH=server/.data/esbot.db
APP_URL=http://localhost:5173
AUTH_TOKEN=dev-token           # bearer token until the ES Account adapter lands
MASTER_KEY=change-me           # encrypts connector secrets at rest
BUDGET_PER_RUN=50              # THB
BUDGET_PER_DAY=300
BLAST_THRESHOLD=20

# Escalations → LINE Messaging API push
LINE_CHANNEL_TOKEN=
LINE_USER_ID=

# Models: OpenRouter only (https://openrouter.ai/keys). Use model ids from openrouter.ai/models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_FALLBACK_MODELS=        # comma-separated, tried in order if the primary fails

# Real MCP servers for the three MVP connectors (Streamable HTTP)
GOOGLE_SHEETS_MCP_URL=
GOOGLE_SHEETS_MCP_TOKEN=
ES_ACCOUNT_MCP_URL=
ES_ACCOUNT_MCP_TOKEN=
LINE_OA_MCP_URL=
LINE_OA_MCP_TOKEN=

# Front-end
VITE_API_TOKEN=dev-token
